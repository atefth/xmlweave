        "types": "./dist/schema-xerces-isolated.d.cts",
        "default": "./dist/schema-xerces-isolated.cjs"
      }
    },
    "./schema-pipeline": {
      "import": {
        "types": "./dist/schema-pipeline.d.ts",
        "default": "./dist/schema-pipeline.js"
      },
      "require": {
        "types": "./dist/schema-pipeline.d.cts",
        "default": "./dist/schema-pipeline.cjs"
      }
    },
    "./schema-factory": {
      "import": {
        "types": "./dist/schema-factory.d.ts",
        "default": "./dist/schema-factory.js"
      },
      "require": {
        "types": "./dist/schema-factory.d.cts",
        "default": "./dist/schema-factory.cjs"
      }
    },
    "./schema-providers": {
      "import": {
        "types": "./dist/schema-providers.d.ts",
