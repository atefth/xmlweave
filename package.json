        "types": "./dist/schema-isolated.d.cts",
        "default": "./dist/schema-isolated.cjs"
      }
    },
    "./schema-java": {
      "import": {
        "types": "./dist/schema-java.d.ts",
        "default": "./dist/schema-java.js"
      },
      "require": {
        "types": "./dist/schema-java.d.cts",
        "default": "./dist/schema-java.cjs"
      }
    },
    "./schema-xerces": {
      "import": {
        "types": "./dist/schema-xerces.d.ts",
        "default": "./dist/schema-xerces.js"
      },
      "require": {
        "types": "./dist/schema-xerces.d.cts",
        "default": "./dist/schema-xerces.cjs"
      }
    },
    "./schema-xerces-isolated": {
      "import": {
