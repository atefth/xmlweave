      },
      "require": {
        "types": "./dist/schema-hints.d.cts",
        "default": "./dist/schema-hints.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "docs",
    "CHANGELOG.md",
    "licenses",
    "scripts/build-xerces.py",
    "native/xerces-validation.cpp",
    "native/README.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.mjs",
    "test:consumers": "node scripts/consumers.mjs",
    "test:browser": "node scripts/browser.mjs",
    "check": "npm run build && npm test && npm run test:consumers && npm run test:browser && npm run test:schema-browser && npm run test:validation-browser && npm run test:java-reference",
    "test:schema-browser": "node scripts/schema-browser.mjs",
    "test:validation-browser": "node scripts/validation-browser.mjs",
    "test:java-reference": "node scripts/compare-java.mjs",
    "build:native": "python scripts/build-xerces.py"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/atefth/xmlweave.git"
  },
  "dependencies": {
    "slimdom": "4.3.5"
  },
  "devDependencies": {
    "@xmldom/xmldom": "0.9.12",
    "esbuild": "0.28.2",
    "fontoxpath": "3.34.0",
    "libxml2-wasm": "0.7.2",
    "playwright": "1.64.1",
    "saxes": "6.0.0",
    "typescript": "7.0.2",
    "xslt-processor": "5.1.2"
  },
  "peerDependencies": {
    "libxml2-wasm": "0.7.2",
    "xslt-processor": "5.1.2"
  },
  "peerDependenciesMeta": {
    "libxml2-wasm": {
      "optional": true
    },
    "xslt-processor": {
      "optional": true
    }
  }
}
